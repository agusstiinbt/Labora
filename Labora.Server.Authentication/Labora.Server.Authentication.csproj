    <PackageReference Include="Microsoft.EntityFrameworkCore.Tools" Version="10.0.1" />
  </ItemGroup>

  <ItemGroup>
    <ContainerPort Include="8081" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Labora.Infrastructure\Labora.Infrastructure.csproj" />
    <ProjectReference Include="..\Labora.ServiceDefaults\Labora.ServiceDefaults.csproj" />
  </ItemGroup>

</Project>
